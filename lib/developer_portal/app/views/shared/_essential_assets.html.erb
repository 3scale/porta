<%# This file only exists to support very old portals that don't use 3scale.js OR 3scale_v2.js.
    It loads a fixed version of jQuery 2.1.4 (with jquery-migrate for 1.x compatibility).
    Packages included in this file are not guaranteed to support jQuery > 2.
%>

<%= csrf_meta_tag %>

<%= javascript_include_tag 'essential_assets/jquery-2.1.4.min.js' %>

<%= javascript_include_tag 'essential_assets/jquery-migrate-1.2.1.min.js' %>

<%= javascript_include_tag 'vendor/jquery.colorbox-min.js' %>
<%= stylesheet_link_tag 'colorbox/colorbox.css' %>

<%= javascript_include_tag 'essential_assets/highlight-7.5',
                           'essential_assets/flash',
                           'essential_assets/remote',
                           'essential_assets/switch',
                           'extra_fields' %>
<%= javascript_include_tag 'application' %>

<%= yield :javascripts %>
