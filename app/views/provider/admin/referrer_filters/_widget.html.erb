<div class="pf-c-card__header">
  <div class="pf-c-card__title pf-u-mr-sm"><%= t('.title') %></div>
  <div class="pf-c-badge pf-m-read"><%= t('.counter', count: cinstance.referrer_filters.size, limit: cinstance.filters_limit) %></div>
</div>

<div class="pf-c-card__body pf-u-pt-0">
  <p class="pf-u-pb-lg"><%= t('.description', limit: cinstance.filters_limit) %></p>

  <table class="pf-c-table pf-m-compact" role="grid">
    <thead><tr></tr></thead>
    <%= render cinstance.referrer_filters, cinstance: %>
  </table>
</div>

<div class="pf-c-card__body">
  <% if cinstance.referrer_filters.can_add? %>
    <%= form_tag provider_admin_application_referrer_filters_path(cinstance), id: 'referrer-filters-form',
                                                                              remote: true,
                                                                              class: 'pf-c-form pf-c-inline-edit pf-m-inline-editable' do %>
      <div class="pf-c-form__group-control">
        <div class="pf-c-inline-edit__group">
          <div class="pf-c-inline-edit__input">
            <%= text_field_tag :referrer_filter, nil, class: 'pf-c-form-control',
                                                      placeholder: t('.add_filter_placeholder') %>
          </div>

          <div class="pf-c-inline-edit__group pf-m-action-group pf-m-icon-group">
            <div class="pf-c-inline-edit__action pf-m-valid">
              <button class="pf-c-button pf-m-link" type="submit">
                <span class="pf-c-button__icon pf-m-start">
                  <i class="fas fa-plus-circle"></i>
                </span>
                <%= t('.add_filter') %>
              </button>
            </div>
          </div>
        </div>
        <p class="pf-c-form__helper-text pf-m-error"></p>
      </div>
    <% end %>
  <% end %>
</div>
