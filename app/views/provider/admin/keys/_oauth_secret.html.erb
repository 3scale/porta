<tr id="<%= dom_id(oauth_secret) %>" class="key" data-key="<%= oauth_secret.to_param %>">
  <td>Application key</td>
  <td class="key" id="oauth_secret"><%= oauth_secret %></td>
  <td>
    <span class="delete_key operations" style="<%= 'display:none;' unless cinstance.can_delete_key? %>">
      <%= fancy_link_to('Regenerate', regenerate_provider_admin_application_key_path(application_id: cinstance.id, id: cinstance.keys.first),
                                      method: :put,
                                      class: 'delete refresh',
                                      remote: true,
                                      id: 'regenerate-oauth-key') %>
    </span>
  </td>
</tr>
