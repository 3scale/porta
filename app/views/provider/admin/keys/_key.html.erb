<%= content_tag(:tr, id: dom_id(key), class: 'key', 'data-key' => key.to_param) do %>
  <td>Application key</td>
  <td class="key"><%= key %></td>
  <td>
    <span class="delete_key operations" style="<%= 'display:none;' unless cinstance.can_delete_key? %>">
      <%= delete_link_for provider_admin_application_key_path(cinstance, key), remote: true %>
    </span>
  </td>
<% end %>
