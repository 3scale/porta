- content_for :menu do
  = render 'menu'

- content_for :page_header_title, "Edit account #{@account.org_name} details"
- content_for :page_header_annotation do
  = render partial: 'shared/annotations', locals: { resource: @account, description: true, variant: :warning }

- content_for :javascripts do
  = stylesheet_packs_chunks_tag 'pf_form'

div class="pf-c-card"
  div class="pf-c-card__body"
    = semantic_form_for @account, builder: Fields::PatternflyFormBuilder,
                        url: admin_buyers_account_path(@account),
                        html: { class: 'pf-c-form pf-m-limit-width' } do |form|
      = form.user_defined_form

      - if current_account.master? && @account.provider?
        = form.input :self_domain, as: :patternfly_input, label: 'Admin domain'

      = form.actions do
        = form.commit_button 'Update Account'
        = delete_buyer_link(@account)

- if current_account.master? && @account.provider?
  javascript:
    (function() {
      var domainInput = document.getElementById('account_self_domain');
      var form = domainInput && domainInput.closest('form');
      if (!domainInput || !form) return;
      var initialDomain = domainInput.value;
      var domainChanged = false;
      var confirmHtml = #{json render('admin_domain_confirm')};

      domainInput.addEventListener('input', function() {
        domainChanged = (domainInput.value !== initialDomain);
      });

      form.addEventListener('submit', function(e) {
        if (!domainChanged) return;
        e.preventDefault();
        colorbox({ html: confirmHtml, title: #{json t('buyers.accounts.edit.admin_domain_confirm_title') }});
      });

      $(document).on('click', '#admin-domain-confirm-btn', function() {
        colorbox.close();
        domainChanged = false;
        form.submit();
      });
    })()